const SCORE_BASE_FASE = {
  'Luna Nueva': 74, 'Luna creciente': 78, 'Cuarto creciente': 62,
  'Luna gibosa creciente': 66, 'Luna Llena': 70, 'Luna gibosa menguante': 58,
  'Cuarto menguante': 54, 'Luna menguante': 50,
