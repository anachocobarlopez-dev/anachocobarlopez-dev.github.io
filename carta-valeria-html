function generarDatosDia(fecha){
  const n = diasDesdeJ2000(fecha);
  const lonSol = longitudSol(n);
  const lonLuna = longitudLuna(n);
  const signoLuna = signoDe(lonLuna);
  const fase = faseLunarDe(lonSol, lonLuna);
  const retro = retrogradosActivos(fecha);

  let score = SCORE_BASE_FASE[fase.nombre] || 60;
  score -= retro.length * 8;
  score += (fecha.getDate() % 7) - 3;
  score = Math.max(5, Math.min(98, Math.round(score)));

  const consejo = CONSEJOS[signoLuna.nombre];
  const retroTxt = retro.length ? ` Con ${retro.join(', ')} retrógrado, conviene revisar antes de avanzar.` : '';

  return {
    faseLuna: `${fase.emoji} ${fase.nombre}`,
    signoLuna: signoLuna.nombre,
    retrogrados: retro,
    energia: TEXTO_FASE[fase.nombre] + retroTxt,
    score: score,
    amor: consejo.amor,
    trabajo: consejo.trabajo,
    dinero: consejo.dinero,
    salud: consejo.salud,
    interpretacionPersonal: INTERPRETACIONES_PERSONALIZADAS[claveFechaObj(fecha)] || "",
  };
}
function claveFechaObj(fecha){
  return claveFecha(fecha.getFullYear(), fecha.getMonth(), fecha.getDate());
}

function infoScore(score){
  if(score >= 90) return {label:'Excelente', color:'var(--cal-c-excelente)', emoji:'🟢'};
  if(score >= 75) return {label:'Muy favorable', color:'var(--cal-c-favorable)', emoji:'🟢'};
  if(score >= 60) return {label:'Favorable', color:'var(--cal-c-neutro)', emoji:'🟡'};
  if(score >= 40) return {label:'Precaución', color:'var(--cal-c-precaucion)', emoji:'🟠'};
  return {label:'Desafiante', color:'var(--cal-c-desafiante)', emoji:'🔴'};
}

const MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const DIAS = ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];

let curY = 2026, curM = 6;

function claveFecha(y,m,d){
  const mm = String(m+1).padStart(2,'0');
  const dd = String(d).padStart(2,'0');
  return `${y}-${mm}-${dd}`;
}

function renderCalendario(){
  document.getElementById('mesTitulo').textContent = `${MESES[curM]} ${curY}`;
  const grilla = document.getElementById('grilla');
  grilla.innerHTML = '';

  DIAS.forEach(d=>{
    const el = document.createElement('div');
    el.className = 'dia-nombre';
    el.textContent = d;
    grilla.appendChild(el);
  });

  const primerDia = new Date(curY, curM, 1);
  let corrimiento = primerDia.getDay();
  corrimiento = corrimiento === 0 ? 6 : corrimiento - 1;
  const diasEnMes = new Date(curY, curM+1, 0).getDate();

  const hoy = new Date();
  const hoyClave = claveFecha(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());

  for(let i=0;i<corrimiento;i++){
    const vacio = document.createElement('div');
    vacio.className = 'dia vacio';
    grilla.appendChild(vacio);
  }

  for(let d=1; d<=diasEnMes; d++){
    const clave = claveFecha(curY, curM, d);
    const fechaDia = new Date(curY, curM, d);
    const datos = generarDatosDia(fechaDia);
    const el = document.createElement('div');
    el.className = 'dia';
    if(clave === hoyClave) el.classList.add('hoy');

    const num = document.createElement('div');
    num.className = 'num';
    num.textContent = d;
    el.appendChild(num);

    const punto = document.createElement('div');
    punto.className = 'punto';
    punto.style.background = infoScore(datos.score).color;
    el.appendChild(punto);

    el.onclick = ()=> abrirModal(clave, datos);
    grilla.appendChild(el);
  }
}

function cambiarMes(dir){
  curM += dir;
  if(curM > 11){curM = 0; curY++;}
  if(curM < 0){curM = 11; curY--;}
  renderCalendario();
}

