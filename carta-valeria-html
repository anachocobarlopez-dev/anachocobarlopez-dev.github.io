function diasDesdeJ2000(fecha){
  const J2000 = Date.UTC(2000,0,1,12,0,0);
  return (fecha.getTime() - J2000) / 86400000;
}
function normalizar(deg){
  deg = deg % 360;
  return deg < 0 ? deg + 360 : deg;
}
function longitudSol(n){
  const L = normalizar(280.460 + 0.9856474*n);
  const g = normalizar(357.528 + 0.9856003*n) * Math.PI/180;
  return normalizar(L + 1.915*Math.sin(g) + 0.020*Math.sin(2*g));
}
function longitudLuna(n){
  const Lp = normalizar(218.316 + 13.176396*n);
  const Mp = normalizar(134.963 + 13.064993*n) * Math.PI/180;
  const D  = normalizar(297.850 + 12.190749*n) * Math.PI/180;
  return normalizar(Lp + 6.289*Math.sin(Mp) + 1.274*Math.sin(2*D - Mp) + 0.658*Math.sin(2*D));
}

const SIGNOS_NOM = ['Aries','Tauro','Géminis','Cáncer','Leo','Virgo','Libra','Escorpio','Sagitario','Capricornio','Acuario','Piscis'];
const SIGNOS_ELEM = ['Fuego','Tierra','Aire','Agua','Fuego','Tierra','Aire','Agua','Fuego','Tierra','Aire','Agua'];
function signoDe(longitud){
  const idx = Math.floor(longitud/30) % 12;
  return {nombre:SIGNOS_NOM[idx], elemento:SIGNOS_ELEM[idx]};
}
function faseLunarDe(longSol, longLuna){
  const dif = normalizar(longLuna - longSol);
  if(dif < 22.5)  return {nombre:'Luna Nueva', emoji:'🌑'};
  if(dif < 67.5)  return {nombre:'Luna creciente', emoji:'🌒'};
  if(dif < 112.5) return {nombre:'Cuarto creciente', emoji:'🌓'};
  if(dif < 157.5) return {nombre:'Luna gibosa creciente', emoji:'🌔'};
  if(dif < 202.5) return {nombre:'Luna Llena', emoji:'🌕'};
  if(dif < 247.5) return {nombre:'Luna gibosa menguante', emoji:'🌖'};
  if(dif < 292.5) return {nombre:'Cuarto menguante', emoji:'🌗'};
  return {nombre:'Luna menguante', emoji:'🌘'};
}

const RETROGRADOS = {
  "Mercurio": [["2026-10-24","2026-11-13"],["2027-02-09","2027-03-03"],["2027-06-10","2027-07-04"],["2027-10-07","2027-10-28"]],
  "Venus": [["2026-10-03","2026-11-13"]],
  "Marte": [["2027-01-10","2027-04-01"]],
  "Júpiter": [["2026-12-12","2027-04-12"]],
  "Saturno": [["2026-07-26","2026-12-10"],["2027-08-09","2027-12-23"]],
  "Urano": [["2026-09-10","2027-02-08"],["2027-09-15","2028-02-12"]],
  "Neptuno": [["2026-07-07","2026-12-12"],["2027-07-09","2027-12-15"]],
  "Plutón": [["2026-05-06","2026-10-15"],["2027-05-08","2027-10-17"]],
};
function retrogradosActivos(fecha){
  const t = fecha.getTime();
  const activos = [];
  for(const planeta in RETROGRADOS){
    for(const [ini,fin] of RETROGRADOS[planeta]){
      if(t >= new Date(ini+"T00:00:00").getTime() && t <= new Date(fin+"T23:59:59").getTime()){
        activos.push(planeta);
        break;
      }
    }
  }
  return activos;
}

