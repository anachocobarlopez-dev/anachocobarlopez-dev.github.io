let tiradaActual = 3;
let cartasElegidas = [];

const POSICIONES_3 = ['Pasado','Presente','Futuro'];
const POSICIONES_4 = ['Situación','Desafío','Consejo','Resultado'];

function barajarMazo(){
  const copia = [...MAZO_TAROT];
  for(let i=copia.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [copia[i],copia[j]] = [copia[j],copia[i]];
  }
  return copia;
}

function elegirTirada(n){
  tiradaActual = n;
  document.getElementById('btnTirada3').classList.toggle('activa', n===3);
  document.getElementById('btnTirada4').classList.toggle('activa', n===4);

  const posiciones = n===3 ? POSICIONES_3 : POSICIONES_4;
  const mazo = barajarMazo();
  cartasElegidas = mazo.slice(0,n);

  const mesa = document.getElementById('cartasMesa');
  mesa.innerHTML = '';
  cartasElegidas.forEach((carta,i)=>{
    const slot = document.createElement('div');
    slot.className = 'carta-slot';
    slot.innerHTML = `
      <div class="carta-posicion">${posiciones[i]}</div>
      <div class="carta" data-idx="${i}">
        <div class="carta-inner">
          <div class="carta-cara carta-dorso"><div class="carta-dorso-sim">✦</div></div>
          <div class="carta-cara carta-frente">
            <div class="num">${carta.n}</div>
            <div class="sim">${carta.sim}</div>
            <div class="nom">${carta.nombre}</div>
          </div>
        </div>
      </div>
    `;
    mesa.appendChild(slot);
  });

  document.querySelectorAll('.carta').forEach(el=>{
    el.onclick = ()=> revelarCarta(el, posiciones);
  });

  document.getElementById('tarotResultado').classList.remove('activo');
  document.getElementById('tarotResultado').innerHTML = '';
  document.getElementById('btnNuevaTirada').style.display = 'block';
}

function revelarCarta(el, posiciones){
  if(el.classList.contains('girada')) return;
  el.classList.add('girada');
  actualizarResultado(posiciones);
}

function actualizarResultado(posiciones){
  const giradas = document.querySelectorAll('.carta.girada');
  if(giradas.length === 0) return;
  const resultado = document.getElementById('tarotResultado');
  resultado.classList.add('activo');
  resultado.innerHTML = '';
  giradas.forEach(el=>{
    const idx = parseInt(el.dataset.idx);
    const carta = cartasElegidas[idx];
    const fila = document.createElement('div');
    fila.className = 'tarot-resultado-fila';
    fila.innerHTML = `
      <div class="pos">${posiciones[idx]}</div>
      <div class="info"><b>${carta.sim} ${carta.nombre}</b><p>${carta.significado}</p></div>
    `;
    resultado.appendChild(fila);
  });
}

