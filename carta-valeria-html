<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Valeria Vanesa Navarro — Carta Astral Dracónica</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --deep:#07050F;--bg:#0C0A18;--bg2:#120F22;--bg3:#1A1630;--bg4:#221E3A;
  --vio:#7B5EA7;--vio-l:#A882D4;--vio-g:rgba(123,94,167,.18);--vio-b:rgba(168,130,212,.25);
  --gold:#C9A84C;--gold-l:#E2C47A;--gold-g:rgba(201,168,76,.12);
  --rose:#C47A9E;--text:#EDE8F5;--muted:#7A7090;--dim:#3E3858;--r:16px;
}
html{scroll-behavior:smooth}
body{font-family:'Jost',sans-serif;background:var(--deep);color:var(--text);min-height:100vh;overflow-x:hidden}
#stars{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.s{position:absolute;border-radius:50%;background:#fff;animation:tw var(--d) ease-in-out infinite var(--dl)}
@keyframes tw{0%,100%{opacity:.06;transform:scale(1)}50%{opacity:.6;transform:scale(1.4)}}
.orb{position:fixed;border-radius:50%;pointer-events:none;filter:blur(90px);z-index:0}
.o1{width:550px;height:550px;background:rgba(123,94,167,.1);top:-120px;left:-180px}
.o2{width:380px;height:380px;background:rgba(201,168,76,.07);bottom:-80px;right:-80px}

/* --- UNIVERSO: planetas flotando + estrellas fugaces --- */
#universo{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.planeta-flot{position:absolute;border-radius:50%;animation:flotar linear infinite;}
@keyframes flotar{
  0%{transform:translate(0,0) rotate(0deg)}
  50%{transform:translate(var(--dx,30px),var(--dy,-40px)) rotate(180deg)}
  100%{transform:translate(0,0) rotate(360deg)}
}
.fugaz{position:absolute;width:2px;height:2px;background:#fff;border-radius:50%;
  box-shadow:0 0 6px 1px #fff;opacity:0;animation:cruzar linear infinite;}
@keyframes cruzar{
  0%{opacity:0;transform:translate(0,0)}
  2%{opacity:1}
  14%{opacity:0;transform:translate(240px,150px)}
  100%{opacity:0;transform:translate(240px,150px)}
}

main{position:relative;z-index:1;max-width:720px;margin:0 auto;padding:0 18px 70px}

/* HERO */
.hero{text-align:center;padding:50px 10px 30px;border-bottom:1px solid var(--vio-b)}
.sello{width:64px;height:64px;margin:0 auto 16px;border:1px solid var(--gold);border-radius:50%;
  display:flex;align-items:center;justify-content:center;font-size:26px;color:var(--gold-l);
  box-shadow:0 0 24px rgba(201,168,76,.25)}
.eyebrow{font-size:.62rem;letter-spacing:.28em;text-transform:uppercase;color:var(--vio-l);margin-bottom:10px}
h1{font-family:'Playfair Display',serif;font-weight:600;font-size:clamp(1.7rem,7vw,2.5rem);color:var(--gold-l);line-height:1.15}
.sub{font-family:'Playfair Display',serif;font-style:italic;font-size:.95rem;color:var(--muted);margin-top:6px}
.datos-nac{margin-top:20px;font-size:.75rem;color:var(--muted);display:flex;flex-wrap:wrap;justify-content:center;gap:12px 18px}
.datos-nac b{color:var(--gold-l);font-weight:400}

/* SECCIONES GENERALES */
.seccion-tag{text-align:center;margin:44px 0 6px;font-size:.62rem;letter-spacing:.3em;text-transform:uppercase;color:var(--vio-l)}
.seccion-title{text-align:center;font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:500;color:var(--text);margin-bottom:8px}
.seccion-desc{text-align:center;font-size:.82rem;color:var(--muted);max-width:480px;margin:0 auto 26px;line-height:1.7}

/* NATAL - breve */
.natal-box{background:var(--bg2);border:1px solid var(--bg4);border-radius:var(--r);padding:22px;margin-bottom:10px}
.natal-row{display:flex;gap:14px;align-items:flex-start;padding:14px 0;border-bottom:1px solid var(--bg4)}
.natal-row:last-child{border-bottom:none}
.natal-ico{font-size:1.3rem;flex-shrink:0;width:34px;text-align:center;color:var(--vio-l)}
.natal-txt b{display:block;font-family:'Playfair Display',serif;font-size:1rem;color:var(--text);margin-bottom:3px}
.natal-txt p{font-size:.8rem;color:var(--muted);line-height:1.6}

/* DRACONICA - acordeon */
.acordeon-item{border:1px solid rgba(201,168,76,.3);border-radius:12px;margin-bottom:12px;background:linear-gradient(180deg,rgba(201,168,76,.03),transparent);overflow:hidden}
.acordeon-cab{display:flex;align-items:center;gap:12px;padding:16px 18px;cursor:pointer;user-select:none}
.acordeon-ico{flex-shrink:0;width:34px;height:34px;border-radius:50%;border:1px solid var(--gold);display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--gold-l)}
.acordeon-eyebrow{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--vio-l);margin-bottom:2px}
.acordeon-titulo{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:600;color:var(--text)}
.flecha{color:var(--gold);font-size:.8rem;margin-left:auto;transition:transform .3s}
.acordeon-item.abierto .flecha{transform:rotate(180deg)}
.acordeon-cuerpo{max-height:0;overflow:hidden;transition:max-height .4s ease;padding:0 18px}
.acordeon-item.abierto .acordeon-cuerpo{padding:0 18px 20px}
.acordeon-cuerpo p{font-size:.82rem;line-height:1.75;color:var(--muted);margin-bottom:10px}
.acordeon-cuerpo p:last-child{margin-bottom:0}
.acordeon-cuerpo strong{color:var(--gold-l);font-weight:400}

/* TABLA PLANETAS */
.tabla-planetas{width:100%;border-collapse:collapse;margin-bottom:14px;font-size:.78rem}
.tabla-planetas th{text-align:left;color:var(--vio-l);font-weight:500;padding:6px 8px;border-bottom:1px solid var(--bg4);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase}
.tabla-planetas td{padding:8px;border-bottom:1px solid var(--bg4);color:var(--text)}
.tabla-planetas td.signo{color:var(--gold-l)}

/* CASAS grid */
.casas-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:6px}
.casa-cel{background:var(--bg3);border:1px solid var(--bg4);border-radius:8px;padding:9px;text-align:center}
.casa-num{font-size:.58rem;color:var(--muted);letter-spacing:.1em}
.casa-val{font-family:'Playfair Display',serif;font-size:.82rem;color:var(--gold-l)}

/* ASTEROIDES - destacados */
.asteroide-card{background:linear-gradient(160deg,rgba(201,168,76,.06),transparent);border:1px solid rgba(201,168,76,.35);border-radius:12px;padding:16px 18px;margin-bottom:12px}
.asteroide-head{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.asteroide-simbolo{font-size:1.1rem;color:var(--gold-l)}
.asteroide-nombre{font-family:'Playfair Display',serif;font-size:1rem;font-weight:600;color:var(--text)}
.asteroide-pos{font-size:.68rem;color:var(--vio-l);letter-spacing:.03em;margin-left:auto}
.asteroide-card p{font-size:.82rem;line-height:1.75;color:var(--muted)}

/* CIERRE */
.cierre{text-align:center;margin-top:44px;padding:26px 18px;border-top:1px solid rgba(201,168,76,.25)}
.cierre p{font-family:'Playfair Display',serif;font-style:italic;font-size:16px;color:var(--muted);max-width:420px;margin:0 auto 14px;line-height:1.6}
.firma{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--vio-l)}

@media(max-width:420px){
  .casas-grid{grid-template-columns:repeat(2,1fr)}
}

/* EXPLORADOR DE SIGNOS */
.signos-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:16px}
.signo-btn{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:1.3rem;
  border:1px solid var(--bg4);border-radius:10px;background:var(--bg3);color:var(--vio-l);
  cursor:pointer;transition:all .2s}
.signo-btn:hover{border-color:var(--vio-b);transform:translateY(-2px)}
.signo-btn.activo{border-color:var(--gold);background:linear-gradient(160deg,rgba(201,168,76,.12),var(--bg3));color:var(--gold-l)}
.signo-resultado{background:var(--bg2);border:1px solid var(--gold);border-radius:var(--r);padding:20px;text-align:center;min-height:170px;display:flex;flex-direction:column;justify-content:center}
.signo-resultado.vacio{border-color:var(--bg4);color:var(--dim);font-style:italic;font-size:.82rem}
.signo-res-simbolo{font-size:2rem;color:var(--gold-l);margin-bottom:6px}
.signo-res-nombre{font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:600;color:var(--text);margin-bottom:12px}
.signo-res-datos{display:flex;justify-content:center;gap:22px;flex-wrap:wrap}
.signo-dato{text-align:center}
.signo-dato-label{font-size:.56rem;letter-spacing:.15em;text-transform:uppercase;color:var(--vio-l);margin-bottom:4px}
.signo-dato-val{font-size:.85rem;color:var(--gold-l)}
@media(max-width:420px){
  .signos-grid{grid-template-columns:repeat(4,1fr)}
}

/* PREGUNTAS Y RESPUESTAS */
.pregunta-card{background:var(--bg2);border:1px solid var(--bg4);border-radius:var(--r);padding:18px 20px;margin-bottom:14px}
.pregunta-num{font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--vio-l);margin-bottom:6px}
.pregunta-texto{font-family:'Playfair Display',serif;font-style:italic;font-size:.95rem;color:var(--text);margin-bottom:14px;line-height:1.5;padding-bottom:14px;border-bottom:1px solid var(--bg4)}
.respuesta-bloque{margin-bottom:10px}
.respuesta-label{font-size:.58rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gold-l);margin-bottom:4px}
.respuesta-texto{font-size:.82rem;line-height:1.65;color:var(--muted)}
.tarot-mini{display:flex;align-items:center;gap:10px;margin-top:12px;padding-top:12px;border-top:1px dashed rgba(203,163,92,.3)}
.tarot-mini-sim{font-size:1.3rem;color:var(--gold-l);flex-shrink:0}
.tarot-mini-nom{font-family:'Playfair Display',serif;font-size:.85rem;color:var(--gold-l);font-weight:600;margin-bottom:2px}
.tarot-mini-txt{font-size:.78rem;line-height:1.55;color:var(--muted)}
.nota-cuidado{font-size:.72rem;font-style:italic;color:var(--vio-l);margin-top:10px;line-height:1.5}

/* ELEMENTOS Y MODALIDADES - barras */
.barra-fila{margin-bottom:14px}
.barra-head{display:flex;justify-content:space-between;font-size:.76rem;margin-bottom:5px}
.barra-head .nom{color:var(--text)}
.barra-head .pct{color:var(--gold-l)}
.barra-track{height:8px;background:var(--bg3);border-radius:8px;overflow:hidden}
.barra-fill{height:100%;border-radius:8px;background:linear-gradient(90deg,var(--vio),var(--gold))}

/* ASPECTOS - juego */
.aspectos-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:16px}

/* RETROGRADACION */
.retro-box{background:var(--bg2);border:1px solid var(--bg4);border-radius:var(--r);padding:18px}
.retro-box p{font-size:.82rem;line-height:1.7;color:var(--muted);margin-bottom:12px}
.retro-lista{display:flex;flex-wrap:wrap;gap:8px}
.retro-tag{font-size:.7rem;border:1px solid var(--gold);color:var(--gold-l);padding:5px 12px;border-radius:20px;background:rgba(201,168,76,.06)}

/* ============ CALENDARIO ASTROLOGICO + TAROT (integrado) ============ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --cal-negro:#0a0a0d;
  --cal-negro2:#141319;
  --cal-negro3:#1c1a24;
  --cal-vio:#8a63d2;
  --cal-vio-suave:#b39ce8;
  --cal-vio-g:rgba(138,99,210,.15);
  --cal-dorado:#cfa646;
  --cal-dorado-suave:#e6c877;
  --cal-dorado-g:rgba(207,166,70,.12);
  --cal-texto:#f0ecf7;
  --cal-tenue:#8c8698;

  --cal-c-excelente:#3fd07a;
  --cal-c-favorable:#9fd84f;
  --cal-c-neutro:#e8c94a;
  --cal-c-precaucion:#e89a3c;
  --cal-c-desafiante:#e2555a;
}

/* --- Header calendario --- */
.cal-header{
  position:relative;z-index:1;
  text-align:center;
  padding:44px 18px 30px;
  border-bottom:1px solid rgba(207,166,70,.2);
}
.mes-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.mes-nav button{
  background:var(--cal-negro3);border:1px solid rgba(138,99,210,.35);color:var(--cal-vio-suave);
  width:36px;height:36px;border-radius:50%;font-size:1rem;cursor:pointer;transition:all .2s;
}
.mes-nav button:hover{background:var(--cal-vio-g);border-color:var(--cal-vio)}
.mes-nav .titulo{font-family:'Playfair Display',serif;font-size:1.25rem;text-transform:capitalize;color:var(--cal-texto)}

.grilla{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:20px}
.dia-nombre{text-align:center;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--cal-tenue);padding:4px 0}
.dia{
  aspect-ratio:1;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:var(--cal-negro2);border:1px solid rgba(255,255,255,.05);cursor:pointer;position:relative;
  transition:all .2s;gap:3px;
}
.dia:hover{border-color:var(--cal-vio)}
.dia.vacio{visibility:hidden;cursor:default}
.dia .num{font-size:.82rem;color:var(--cal-texto)}
.dia .punto{width:6px;height:6px;border-radius:50%}
.dia.hoy{border-color:var(--cal-dorado);box-shadow:0 0 0 1px var(--cal-dorado)}
.dia.sin-datos .num{color:var(--cal-tenue)}

.leyenda{
  background:var(--cal-negro2);border:1px solid rgba(255,255,255,.06);border-radius:14px;
  padding:16px 18px;margin-bottom:24px;
}
.leyenda-t{font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--cal-vio-suave);margin-bottom:12px}
.leyenda-fila{display:flex;align-items:center;gap:10px;font-size:.76rem;color:var(--cal-tenue);padding:4px 0}
.leyenda-fila .punto{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.leyenda-fila b{color:var(--cal-texto);font-weight:400}

/* --- Modal --- */
.overlay{
  position:fixed;inset:0;background:rgba(6,5,9,.82);backdrop-filter:blur(6px);
  display:none;align-items:flex-end;justify-content:center;z-index:200;
}
.overlay.activo{display:flex}
@media(min-width:600px){.overlay{align-items:center}}

.modal{
  background:linear-gradient(165deg,var(--cal-negro3),var(--cal-negro2));
  border:1px solid rgba(207,166,70,.3);
  border-radius:22px 22px 0 0;
  width:100%;max-width:480px;max-height:88vh;overflow-y:auto;
  padding:26px 22px 30px;
  position:relative;
  animation:subir .3s ease;
}
@media(min-width:600px){.modal{border-radius:20px}}
@keyframes subir{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}

.modal-cerrar{
  position:absolute;top:16px;right:16px;width:30px;height:30px;border-radius:50%;
  background:var(--cal-negro2);border:1px solid rgba(255,255,255,.1);color:var(--cal-tenue);
  cursor:pointer;font-size:.9rem;display:flex;align-items:center;justify-content:center;
}
.modal-fecha{font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--cal-dorado-suave);margin-bottom:2px;padding-right:30px}
.modal-fecha-sub{font-size:.72rem;color:var(--cal-tenue);text-transform:capitalize;margin-bottom:18px}

.energia-badge{
  display:inline-flex;align-items:center;gap:8px;
  padding:8px 16px;border-radius:20px;margin-bottom:20px;
  font-size:.78rem;font-weight:500;
}
.energia-badge .punto{width:9px;height:9px;border-radius:50%}
.energia-score{font-size:.65rem;opacity:.75;margin-left:4px}

.modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px}
.modal-dato{background:var(--cal-negro2);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:10px 12px}
.modal-dato-l{font-size:.55rem;letter-spacing:.12em;text-transform:uppercase;color:var(--cal-vio-suave);margin-bottom:3px}
.modal-dato-v{font-size:.8rem;color:var(--cal-texto)}

.modal-seccion{margin-bottom:16px}
.modal-seccion-t{font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--cal-dorado-suave);margin-bottom:6px}
.modal-seccion p{font-size:.82rem;line-height:1.65;color:var(--cal-tenue)}

.rec-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:6px}
.rec-card{background:var(--cal-negro2);border:1px solid rgba(255,255,255,.06);border-radius:12px;padding:12px}
.rec-card .ico{font-size:1.05rem;margin-bottom:5px}
.rec-card .titulo{font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;color:var(--cal-vio-suave);margin-bottom:4px}
.rec-card p{font-size:.74rem;line-height:1.5;color:var(--cal-tenue)}

.personal-box{
  border:1px dashed rgba(207,166,70,.35);border-radius:12px;padding:14px;margin-top:6px;
  background:rgba(207,166,70,.04);
}
.personal-box .titulo{font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--cal-dorado-suave);margin-bottom:6px}
.personal-box p{font-size:.78rem;line-height:1.6;color:var(--cal-tenue);font-style:italic}
.personal-box p.vacio{opacity:.55}

.sin-datos-msg{text-align:center;padding:30px 10px;color:var(--cal-tenue);font-style:italic;font-size:.85rem}

@media(max-width:360px){
  .rec-grid{grid-template-columns:1fr}
}

/* --- TAROT INTERACTIVO --- */
.tarot-seccion{margin-top:34px;padding-top:30px;border-top:1px solid rgba(207,166,70,.2)}
.tarot-header{text-align:center;margin-bottom:20px}
.tarot-eyebrow{font-size:.6rem;letter-spacing:.28em;text-transform:uppercase;color:var(--cal-vio-suave);margin-bottom:8px}
.tarot-titulo{font-family:'Playfair Display',serif;font-weight:600;font-size:1.4rem;color:var(--cal-dorado-suave)}
.tarot-sub{font-family:'Playfair Display',serif;font-style:italic;color:var(--cal-tenue);font-size:.85rem;margin-top:4px}

.tirada-selector{display:flex;gap:10px;justify-content:center;margin-bottom:22px;flex-wrap:wrap}
.tirada-btn{
  background:var(--cal-negro2);border:1px solid rgba(138,99,210,.35);color:var(--cal-vio-suave);
  padding:9px 18px;border-radius:20px;font-size:.78rem;cursor:pointer;transition:all .2s;font-family:'Jost',sans-serif;
}
.tirada-btn:hover{border-color:var(--cal-vio)}
.tirada-btn.activa{background:var(--cal-vio-g);border-color:var(--cal-vio);color:var(--cal-vio-suave)}

.cartas-mesa{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}
.carta-slot{display:flex;flex-direction:column;align-items:center;gap:8px}
.carta-posicion{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--cal-vio-suave);text-align:center;max-width:90px}
.carta{width:82px;height:132px;perspective:900px;cursor:pointer}
.carta-inner{position:relative;width:100%;height:100%;transition:transform .6s cubic-bezier(.4,.2,.2,1);transform-style:preserve-3d}
.carta.girada .carta-inner{transform:rotateY(180deg)}
.carta-cara{position:absolute;inset:0;backface-visibility:hidden;border-radius:10px;border:1px solid var(--cal-dorado);
  display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:8px}
.carta-dorso{
  background:repeating-linear-gradient(45deg, rgba(207,166,70,.08) 0 2px, transparent 2px 12px),
             linear-gradient(160deg,var(--cal-negro3),var(--cal-negro));
}
.carta-dorso-sim{width:34px;height:34px;border:1px solid var(--cal-dorado);border-radius:50%;
  display:flex;align-items:center;justify-content:center;font-size:1rem;color:var(--cal-dorado-suave)}
.carta-frente{background:linear-gradient(165deg,#241f30,var(--cal-negro));transform:rotateY(180deg)}
.carta-frente .num{font-size:.55rem;letter-spacing:.1em;color:var(--cal-vio-suave);margin-bottom:4px}
.carta-frente .sim{font-size:1.3rem;margin-bottom:4px;color:var(--cal-dorado-suave)}
.carta-frente .nom{font-family:'Playfair Display',serif;font-size:.72rem;font-weight:600;color:var(--cal-dorado-suave);line-height:1.15}

.tarot-resultado{background:var(--cal-negro2);border:1px solid rgba(255,255,255,.06);border-radius:14px;padding:16px 18px;display:none}
.tarot-resultado.activo{display:block}
.tarot-resultado-fila{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.05)}
